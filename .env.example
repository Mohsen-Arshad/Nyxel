# Copy to your shell/session environment. Do not commit real secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash

# Local providers
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
LMSTUDIO_MODEL=
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# Set false when you only want real providers.
NYXELRELAY_ENABLE_DEMO=true

# Optional local Laya policy service. NyxelRelay remains fully functional without it.
# Example: http://127.0.0.1:8000
NYXELRELAY_LAYA_URL=
NYXELRELAY_LAYA_API_KEY=
NYXELRELAY_LAYA_TIMEOUT_MS=1500
